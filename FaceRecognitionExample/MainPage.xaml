<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FaceRecognitionExample.MainPage">

    <Grid>
        <!-- 1:1 Camera Container -->
        <Grid x:Name="cameraContainer" HorizontalOptions="Center" VerticalOptions="Center">
            <!-- Camera Preview -->
            <toolkit:CameraView 
                x:Name="cameraView"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                MediaCaptured="OnMediaCaptured" />

            <!-- Container for Results -->
            <Grid x:Name="resultContainer" IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill">
                
                <!-- State 0: Original + BBox -->
                <Grid x:Name="gridOriginal" HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Image 
                        x:Name="imgPreview"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Aspect="AspectFill" />
                    
                    <GraphicsView 
                        x:Name="graphicsView"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        InputTransparent="True" />
                </Grid>

                <!-- State 1: Cropped Face -->
                <Grid x:Name="gridCropped" IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="Black">
                    <Image 
                        x:Name="imgCroppedFace"
                        Aspect="AspectFit"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />
                </Grid>

                <!-- Caption Label -->
                <Label x:Name="lblPreviewCaption"
                       Text="Gambar Asli + Bounding Box"
                       TextColor="White"
                       BackgroundColor="#AA000000"
                       Padding="10,5"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,15,0,0" />
            </Grid>
        </Grid>

        <Label x:Name="lblStatus" 
               TextColor="#FFFFFF" 
               BackgroundColor="#000000" 
               VerticalOptions="Start" 
               HorizontalOptions="Center" 
               Margin="0, 20, 0, 0"
               Padding="10, 5" />

        <ActivityIndicator 
            x:Name="loadingIndicator"
            IsRunning="False"
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="White" />

        <!-- Controls -->
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0, 0, 0, 30"
            Spacing="15">
            
            <Slider x:Name="sliderPreview"
                    Minimum="0" Maximum="1" Value="0"
                    IsVisible="False"
                    ValueChanged="OnPreviewSliderValueChanged"
                    HorizontalOptions="Center" WidthRequest="250" />

            <HorizontalStackLayout
                x:Name="controlPanel"
                HorizontalOptions="Center"
                Spacing="20">
            
            <Button 
                x:Name="btnSwitchCamera"
                Text="Switch Camera"
                Clicked="OnSwitchCameraClicked" />

            <Button 
                x:Name="btnCapture"
                Text="Capture &amp; Detect"
                Clicked="OnCaptureClicked" />

            <Button
                x:Name="btnLiveTracking"
                Text="Live Tracking"
                Clicked="OnLiveTrackingClicked" />

            <Button 
                x:Name="btnRetake"
                Text="Retake"
                IsVisible="False"
                Clicked="OnRetakeClicked" />
        </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
